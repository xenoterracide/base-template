{
  "name": "@xenoterracide/share",
  "packageManager": "pnpm@12.18.0",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "git-conventional-commits": "^2.8.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "prettier-plugin-properties": "^0.3.0",
    "prettier-plugin-toml": "^4.0.0",
    "renovate": "^44.227.2"
  },
  "scripts": {
    "check": "pnpm lint",
    "contribute": "sh .config/git/hooks/heal.sh",
    "lint:prettier": "prettier --ignore-unknown --cache --check '**'",
    "lint:reuse": "pnpm reuse download --all && pnpm reuse lint",
    "lint:shellcheck": "shellcheck $(git ls-files '*.sh' '.envrc' ':(glob)**/git/hooks/*')",
    "lint": "pnpm lint:prettier && pnpm lint:shellcheck",
    "precontribute": "npm run setup:corepack",
    "reuse": "uv run --frozen --group dev reuse",
    "setup:corepack": "npm install --global corepack && mkdir -p ~/.local/bin && corepack enable --install-directory ~/.local/bin"
  }
}
