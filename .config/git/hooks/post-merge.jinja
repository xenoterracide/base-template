# Skip in CI environments
[ -n "$CI" ] && exit 0

# Check if toolchain or lockfiles changed in this merge (HEAD@{1} is the state before the merge)
TOOL_VERSIONS_CHANGED=0
PNPM_LOCK_CHANGED=0
UV_LOCK_CHANGED=0

if ! git diff --quiet "HEAD@{1}" HEAD -- .tool-versions 2>/dev/null; then
  TOOL_VERSIONS_CHANGED=1
fi

if ! git diff --quiet "HEAD@{1}" HEAD -- pnpm-lock.yaml 2>/dev/null; then
  PNPM_LOCK_CHANGED=1
fi

if ! git diff --quiet "HEAD@{1}" HEAD -- uv.lock 2>/dev/null; then
  UV_LOCK_CHANGED=1
fi

# Heal once, naming every marker that changed.
CHANGED=""

if [ "$TOOL_VERSIONS_CHANGED" -eq 1 ]; then
  CHANGED=".tool-versions"
fi

if [ "$PNPM_LOCK_CHANGED" -eq 1 ]; then
  CHANGED="$CHANGED pnpm-lock.yaml"
fi

if [ "$UV_LOCK_CHANGED" -eq 1 ]; then
  CHANGED="$CHANGED uv.lock"
fi

if [ -n "$CHANGED" ]; then
  echo "$CHANGED changed, healing toolchain..."
  "$(dirname "$0")/heal.sh"
fi
