version = 1

[[annotations]]
path = "**/*.lockfile"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"

[[annotations]]
path = "pnpm-lock.yaml"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"

[[annotations]]
path = ".tool-versions"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"

[[annotations]]
path = "uv.lock"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"

[[annotations]]
path = ".python-version"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"{% if template_type == 'java' %}

[[annotations]]
path = "mvnw"
SPDX-FileCopyrightText = "See license header in file"
SPDX-License-Identifier = "Apache-2.0"

[[annotations]]
path = "mvnw.cmd"
SPDX-FileCopyrightText = "See license header in file"
SPDX-License-Identifier = "Apache-2.0"

[[annotations]]
path = ".mvn/jvm.config"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"

[[annotations]]
path = ".mvn/wrapper/maven-wrapper.properties"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"{% endif %}

[[annotations]]
path = "**/package.json"
SPDX-FileCopyrightText = "Copyright © 2026 Caleb Cushing"
SPDX-License-Identifier = "MIT"

[[annotations]]
path = "**/tsconfig*.json"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "CC0-1.0"

# Hooks carry no headers: lint-staged skips them because a hook runs while
# lint-staged may rewrite it, and a rewrite under the executing shell
# corrupts the script. This annotation licenses them instead.
[[annotations]]
path = ".config/git/hooks/**"
SPDX-FileCopyrightText = "NONE"
SPDX-License-Identifier = "MIT"
