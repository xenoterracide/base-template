{
  "name": "{{ project_name }}",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "license": "{{ license }}",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "git-conventional-commits": "^2.8.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "prettier-plugin-properties": "^0.3.0",
    "prettier-plugin-toml": "^4.0.0"{% if template_type == 'typescript' %},
    "@eslint/js": "^10.0.0",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jiti": "^2.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.3"{% endif %}
  },
  "scripts": {
    "check": "pnpm lint:prettier{% if template_type == 'typescript' %} && pnpm lint:eslint && pnpm typecheck && pnpm test{% endif %}",
    "contribute": "sh .config/git/hooks/heal.sh",
    "lint:prettier": "prettier --ignore-unknown --cache --check '**'",
    "lint:reuse": "pnpm reuse lint",
    "precontribute": "pnpm setup:corepack",
    "reuse": "uv run --frozen --group dev reuse",
    "setup:corepack": "npm install --global corepack && corepack enable --install-directory ~/.local/bin"{% if template_type == 'typescript' %},
    "lint:eslint": "eslint .",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:reuse",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run --coverage"{% else %},
    "lint": "pnpm lint:prettier && pnpm lint:reuse"{% endif %}
  }
}
