{% if template_type == 'typescript' %}packages:
  - "packages/*"

{% endif %}# pnpm's release-age gate, written down so it cannot be softened
# silently: a day-0 pin fails loudly here instead of pnpm appending a
# minimumReleaseAgeExclude bypass to this file
minimumReleaseAge: 1440
minimumReleaseAgeStrict: true
